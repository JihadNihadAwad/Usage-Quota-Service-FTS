# --- api ---
PORT=3000
LOG_LEVEL=info
# Dev database: `docker compose up -d db` (postgres:17-alpine on localhost:5432).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fts
# Postgres connections per api process. pg's default is 10; 100 is
# Postgres' own connection limit.
POOL_MAX=10
# Integration-test database: `docker compose --profile test up -d db-test` (:5433).
# Read by the vitest integration project only; `npm run test:integration`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/fts_test

# --- example client (client/) ---
CLIENT_PORT=3001
USAGE_API_URL=http://localhost:3000/v1
